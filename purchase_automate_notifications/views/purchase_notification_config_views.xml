<!-- views/purchase_notification_config_view.xml -->
<odoo>
  <record id="view_purchase_notification_config_form" model="ir.ui.view">
    <field name="name">purchase.notification.config.form</field>
    <field name="model">purchase.notification.config</field>
    <field name="arch" type="xml">
      <form string="Notificaciones de Compras">
        <group col="1">
          <field name="name" invisible="0" />
          <field name="user_ids" invisible="1" />


          <group name="group_1" string="Usuarios a notificar" col="12">
            <field name="employee_ids" nolabel="1" >
                <tree create="true" delete="true" editable="top">
                  <field name="name" />
                  <field name="work_email" string="Email del trabajo"/>
                  <field name="company_id" />
                  <field name="department_id" />
              </tree>
          </field>
          </group>
          

          <group name="group_2" string="Usuarios a notificar Incidencias" col="12">
            <field name="employee_bad_inspection_ids" nolabel="1" >
                <tree create="true" delete="true" editable="top">
                  <field name="name" />
                  <field name="work_email" string="Email del trabajo"/>
                  <field name="company_id" />
                  <field name="department_id" />
              </tree>
          </field>
          </group>
        </group>
      </form>
    </field>
  </record>

  <record id="model_purchase_notification_config_tree" model="ir.ui.view">
    <field name="name">purchase.notification.config.view.tree</field>
    <field name="model">purchase.notification.config</field>
    <field name="arch" type="xml">
        <tree string="Notificaciones de Compras">
                      <field name="employee_ids" widget="many2many_tags"/>

                      

        </tree>
    </field>
  </record>

  <record id="action_purchase_notification_config" model="ir.actions.act_window">
    <field name="name">Configuración de Notificaciones</field>
    <field name="res_model">purchase.notification.config</field>
    <field name="view_mode">tree,form</field>
    <field name="target">current</field>
  </record>

  <menuitem id="menu_purchase_notification_config" 
            name="Usuarios a notificar recepcion de materiales"
            parent="purchase.menu_purchase_config"
            action="action_purchase_notification_config"/>
</odoo>
