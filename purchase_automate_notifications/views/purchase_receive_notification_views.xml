<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.receive.notification View Tree -->
    <record id="view_purchase_receive_notification_tree" model="ir.ui.view">
        <field name="name">view.purchase.receive.notification.tree</field>
        <field name="model">purchase.receive.notification</field>
        <field name="arch" type="xml">
            <tree>
                    <field name="picking_id" />
                    <field name="purchase_id" />
                    <field name="analytic_account_id" />
                    <field name="project_id" />
                    <field name="state" />



            </tree>
        </field>
    </record>

    <!-- View purchase.receive.notification form -->
    <record id="view_purchase_receive_notification_form" model="ir.ui.view">
        <field name="name">purchase.receive.notification.form</field>
        <field name="model">purchase.receive.notification</field>
        <field name="arch" type="xml">
        <form string="Notificación de recepción de materiales">
            <sheet>
            <group>
                <field name="picking_id"/>
                <field name="purchase_id" />
                <field name="analytic_account_id" />

                <field name="analytic_account_parent_id" />
                <field name="analytic_user_id" />

                <field name="project_id" />
                <field name="analytic_user_id" />

                <field name="state" readonly="1"/>
                <field name="email_table_html" readonly="1"/>
            </group>

            <footer>
                <button name="send_notification_email"
                        type="object"
                        string="Reenviar Correo"
                        class="btn-primary"/>
            </footer>
            </sheet>
        </form>
        </field>
  </record>

  <record id="action_purchase_receive_notification" model="ir.actions.act_window">
    <field name="name">Notificación de recepción de materiales</field>
    <field name="res_model">purchase.receive.notification</field>
    <field name="view_mode">tree,form</field>
    <field name="target">current</field>
  </record>


  <menuitem id="menu_purchase_receive_notification" 
            name="Correos de notificación de recepción de materiales"
            parent="purchase.menu_purchase_config"
            action="action_purchase_receive_notification"/>


</odoo>
