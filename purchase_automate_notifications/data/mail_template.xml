<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="template_receive_material_email" model="mail.template">
    <field name="name">RECEPCIÓN DE MATERIAL</field>
    <field name="model_id" ref="purchase_automate_notifications.model_purchase_receive_notification"/>
    <field name="subject">RECEPCIÓN DE MATERIAL - ${object.purchase_id.name} - ${object.analytic_account_parent_id.name}</field>
    <field name="email_from">${(user.email or 'info@dominio.com')}</field>
    <field name="auto_delete" eval="False"/>
    <field name="body_html" type="html">
        <html>
        <body>
            <p>Hola,</p>
            <p>Se ha registrado la siguiente recepción en el albarán <strong><a href="${object.picking_url}" target="_blank" >${object.picking_id.name}</a></strong> correspondiente al <strong><a href="${object.purchase_url}" target="_blank" >${object.purchase_id.name}</a></strong>. La recepción la acaba de registrar  <strong>${object.picking_id.employee_id.name}</strong> 
            </p>
            <div>${object.email_table_html | safe}</div>
        </body>
        </html>
    </field>
    </record>
  </data>
</odoo>
