<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_supplier_form_purchase_receipts" model="ir.ui.view">
        <field name="name">account.invoice.supplier.form.purchase.receipts</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_supplier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="purchase_receipt_id" readonly="1"/>
                <field name="purchase_stock_move_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                <attribute name="attrs">{'readonly': [('purchase_stock_move_ids', '!=', [])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='uom_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('purchase_stock_move_ids', '!=', [])]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
