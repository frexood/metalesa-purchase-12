<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_picking_invoice_wizard_form" model="ir.ui.view">
        <field name="name">purchase.picking.invoice.wizard.form</field>
        <field name="model">purchase.picking.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Vendor Bills from Receipts">
                <group>
                    <field name="picking_ids" widget="many2many_tags"/>
                    <field name="grouping"/>
                </group>
                <footer>
                    <button name="action_create_invoices" type="object"
                            string="Create Vendor Bills" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_picking_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Create Vendor Bills from Receipts</field>
        <field name="res_model">purchase.picking.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="purchase_picking_invoice_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
</odoo>
